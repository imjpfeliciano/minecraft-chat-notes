{
  "schemaVersion": 1,
  "id": "chatnotes",
  "version": "${version}",
  "name": "Chat Notes",
  "description": "A personal library of chat snippets. Store formatted messages and copy them to the clipboard or drop them straight into the chat box.",
  "authors": [
    "Jonathan Peraza Feliciano"
  ],
  "license": "MIT",
  "icon": "assets/chatnotes/icon.png",
  "environment": "client",
  "accessWidener": "chatnotes.accesswidener",
  "entrypoints": {
    "client": [
      "com.imjpfeliciano.chatnotes.ChatNotesClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
